{
  "name": "neraca",
  "version": "1.0.0",
  "description": "Pencatat pengeluaran pribadi dengan kartu kredit, cicilan, dan laporan bulanan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply neraca --local",
    "db:migrate:remote": "wrangler d1 migrations apply neraca --remote",
    "deploy": "npm run build && wrangler deploy",
    "typegen": "wrangler types src/worker/env.d.ts --env-interface Env"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@vitejs/plugin-react": "6.1.2",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "react-select": "5.10.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
