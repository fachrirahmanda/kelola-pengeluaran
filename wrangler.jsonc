{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neraca",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // React app built by Vite; unknown paths fall back to index.html for client-side routing.
  // /api/* always reaches the Worker first.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neraca",
      "database_id": "efb70dc9-b8ee-47d1-b8e3-059548e086a5",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID). Not a secret.
    "GOOGLE_CLIENT_ID": "823910878019-3id9lq5i8jfrmbvcr0mti9n6ld64pol5.apps.googleusercontent.com",
    // The admin account: connects the app's Google Drive for receipt attachments.
    "ADMIN_EMAIL": "fachrirahmanda.comen@gmail.com",
  },
  "observability": { "enabled": true },
}
